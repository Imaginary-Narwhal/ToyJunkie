    <Button name="TJ_ToyBoxHeaderTemplate" virtual="true" inherits="BackdropTemplate">
        <Size y="36" />
        <KeyValues>
            <KeyValue key="backdropInfo" value="BACKDROP_TOAST_12_12" type="global" />
        </KeyValues>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontWhite" justifyH="LEFT"
                    wordwrap="false">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="50" y="0" />
                        <Anchor point="BOTTOMRIGHT" x="-4" y="0" />
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="expandIcon" file="Interface/Buttons/UI-MinusButton-Up">
                    <Size x="18" y="18" />
                    <Anchors>
                        <Anchor point="LEFT" x="7" y="0.5" />
                    </Anchors>
                </Texture>
                <Texture parentKey="icon"
                    file="Interface/Icons/TRADE_ARCHAEOLOGY_CHESTOFTINYGLASSANIMALS">
                    <Size x="26" y="26" />
                    <Anchors>
                        <Anchor point="LEFT" x="25" y="0.5" />
                    </Anchors>
                </Texture>
                <FontString parentKey="counterText" inherits="GameFontHighlightOutline" justifyH="RIGHT" wordwrap="false">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="18" y="-3"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGH">
                <Texture parentKey="highlightLeft" file="Interface/Buttons/WHITE8X8">
                    <Size y="27" />
                    <Anchors>
                        <Anchor point="LEFT" />
                    </Anchors>
                    <Gradient orientation="HORIZONTAL">
                        <MinColor a="0" r="1" g="1" b="1" />
                        <MaxColor a=".25" r="1" g="1" b="1" />
                    </Gradient>
                </Texture>
            </Layer>
            <Layer level="HIGH">
                <Texture parentKey="highlightRight" file="Interface/Buttons/WHITE8X8">
                    <Size y="27" />
                    <Anchors>
                        <Anchor point="RIGHT" />
                    </Anchors>
                    <Gradient orientation="HORIZONTAL">
                        <MinColor a=".25" r="1" g="1" b="1" />
                        <MaxColor a="0" r="1" g="1" b="1" />
                    </Gradient>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="EditButton" hidden="true">
                <Size x="16" y="16"/>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture file="Interface/WorldMap/Gear_64Grey" alpha="0.5" parentKey="texture"/>
                    </Layer>
                </Layers>
                
                <Anchors>
                    <Anchor point="RIGHT" x="-5" y="0"/>
                </Anchors>
                <Scripts>
                    <OnEnter>
                        self:Show()
                        self.texture:SetAlpha(1.0)
                        GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                        GameTooltip:AddLine("Toybox settings")
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave>
                        self.texture:SetAlpha(0.5)
                        GameTooltip:Hide()
                    </OnLeave>
                    <OnMouseDown>
                        EditToyBox(self:GetParent())
                    </OnMouseDown>
                </Scripts>
            </Button>
            <EditBox parentKey="RenameBox" inherits="InputBoxTemplate" autoFocus="false">
                <Anchors>
                    <Anchor point="TOPLEFT" x="54" y="0" />
                    <Anchor point="BOTTOMRIGHT" x="-8" y="0" />
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self:Hide()
                    </OnLoad>
                </Scripts>
                <Frames>
                    <Button parentKey="Cancel">
                        <Size x="14" y="14" />
                        <NormalTexture atlas="Radial_Wheel_Icon_Close" />
                        <Anchors>
                            <Anchor Point="RIGHT" x="-4" y="0" />
                        </Anchors>
                        <Scripts>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                                GameTooltip:AddLine("Cancel")
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                        </Scripts>
                    </Button>
                    <Button parentKey="Submit">
                        <Size x="14" y="14" />
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="Texture" atlas="orderhalltalents-done-checkmark">
                                    <Size x="16" y="16" />
                                </Texture>
                            </Layer>
                        </Layers>
                        <Anchors>
                            <Anchor Point="RIGHT" x="-22" y="0" />
                        </Anchors>
                        <Scripts>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                                GameTooltip:AddLine("Okay")
                                GameTooltip:Show()
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                            </OnLeave>
                            <OnDisable>
                                self.Texture:SetVertexColor(.2,.2,.2,1)
                            </OnDisable>
                            <OnEnable>
                                self.Texture:SetVertexColor(1,1,1,1)
                            </OnEnable>
                        </Scripts>
                    </Button>
                </Frames>
            </EditBox>
        </Frames>
    </Button>

